# Copy to .env on the Linux server. The same UPLOAD_SECRET goes into STORAGE_UPLOAD_SECRET
# on Vercel and in .env.local of the machine that runs `npm run docs:upload-selfhost`.
# Generate one with:  openssl rand -base64 48
UPLOAD_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Where files live on the host (mounted into the container at /data).
DATA_PATH=/srv/vtnf-storage

# Upload size cap in bytes (default 5 GB).
MAX_BYTES=5368709120

# Comma-separated origins allowed to upload from the browser, or * (uploads are signed anyway).
ALLOWED_ORIGINS=*
