# --- Google Maps (client) ---
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# --- Cloudinary (server only, never expose the secret to the client) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Root folder used for every uploaded document
CLOUDINARY_ROOT_FOLDER=v-tnf
# Cloud name is also needed by the client to build delivery URLs (public info)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# --- Gemini (server only). Leave AI_ANALYSIS_ENABLED=false to use rule-based analysis. ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AI_ANALYSIS_ENABLED=false

# --- Admin upload (server only) ---
ADMIN_PASSWORD=change_me
ADMIN_TOKEN_SECRET=change_me_to_a_long_random_string

# --- Local document source (only needed by scripts/ on a machine with the Z: share) ---
DOCS_SOURCE_DIR=Z:\Public\7. MỤC TIÊU CÔNG TY - BỘ PHẬN - AMEBA\※V-TNF工法研究\★開発関係資料
